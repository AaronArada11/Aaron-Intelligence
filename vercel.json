{
  "version": 2,
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/github-commits",
      "destination": "/api/github_commits"
    },
    {
      "source": "/((?!api/|assets/|favicon\\.ico$|favicon\\.png$).*)",
      "destination": "/index.html"
    }
  ]
}
